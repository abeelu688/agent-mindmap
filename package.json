{
  "name": "agent-mindmap-workspace",
  "private": true,
  "version": "0.2.3",
  "license": "MIT",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "build": "bash scripts/build.sh",
    "build:shared": "npm run build --prefix shared",
    "build:core": "npm run build --prefix shared && npm run build --prefix core",
    "build:mcp": "node scripts/bundle-mcp-server.mjs",
    "build:cli": "npm run build:core && npm run build --prefix cli",
    "build:extension": "npm run build --prefix extension",
    "build:webview": "npm run build --prefix webview",
    "watch": "concurrently --kill-others \"npm run watch --prefix extension\" \"npm run watch --prefix webview\"",
    "test": "npm run build --prefix extension && vitest run",
    "test:vitest": "vitest run",
    "test:mcp": "vitest run test/mcpShared.test.ts test/mcpInstallConfig.test.ts test/workspaceToSlug.test.ts",
    "test:retrieval": "vitest run test/retrievalEval.test.ts",
    "lint": "eslint \"core/src/**/*.ts\" \"cli/src/**/*.ts\" \"extension/src/**/*.ts\" \"webview/src/**/*.ts\" \"shared/src/**/*.ts\" \"mcp-server/src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint --fix \"core/src/**/*.ts\" \"cli/src/**/*.ts\" \"extension/src/**/*.ts\" \"webview/src/**/*.ts\" \"shared/src/**/*.ts\" \"mcp-server/src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"extension/src/**/*.ts\" \"webview/src/**/*.ts\" \"core/src/**/*.ts\" \"test/**/*.ts\" \"*.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"extension/src/**/*.ts\" \"webview/src/**/*.ts\" \"core/src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "npm run typecheck:shared && npm run typecheck:core && npm run typecheck:extension && npm run typecheck:webview && npm run typecheck:mcp",
    "typecheck:shared": "tsc --noEmit --project shared/tsconfig.json",
    "typecheck:core": "npm run build --prefix shared && tsc --noEmit --project core/tsconfig.json",
    "typecheck:extension": "npm run build:core && tsc --noEmit --project extension/tsconfig.json",
    "typecheck:webview": "tsc --noEmit --project webview/tsconfig.json",
    "typecheck:mcp": "npm run build:core && tsc --noEmit --project mcp-server/tsconfig.json",
    "check:concept-nodes": "node scripts/check-hardcoded-concept-nodes.mjs",
    "check:l10n": "node scripts/check-l10n-keys.mjs",
    "checklist:l10n": "node scripts/generate-multilingual-checklist.mjs",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "smoke:cli-boundaries": "node scripts/smoke-cli-boundaries.mjs",
    "check": "npm run version:check && npm run typecheck && npm run lint && npm run format:check && npm run check:concept-nodes && npm run check:l10n && npm run check:boundaries",
    "eval": "npm run build --prefix extension && node extension/dist/eval-run.js",
    "eval:fixtures:export": "node test/eval/export-aosp14-fixtures.mjs",
    "fixtures:generate": "node scripts/generate-multilingual-fixtures.mjs",
    "package": "npm run build && npm run package --prefix extension",
    "package:vsix": "bash scripts/package-vsix.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "concurrently": "^9.2.3",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.2",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.8.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "8.61.0",
    "vitest": "^2.1.9",
    "zod": "^3.24.2"
  }
}
